results/signals_v2/
data/
# Point-in-time scans for the walk-forward backtest. One folder per --as-of
# cutoff, ~2600 files of ~170KB each, so roughly 440MB per cutoff -- and
# signal_scanner.py rewrites every file on each run, so git could not delta
# them even if they belonged here. .git is already ~5.2GB after 80 commits
# (see the warning at the top of .github/workflows/daily-scan.yml); these
# would push it over GitHub's limits on their own. Regenerate them from
# signal_scanner.py --as-of instead, or keep them in object storage.
results/signals_asof_*

# Distilled from the above by build_vocabulary.py -- ~600k rows / tens of MB,
# and reproducible from the scan folder in seconds.
results/vocabulary_*.csv

# Backtest outputs. backtest_candidates.parquet is ~800k resolved episodes
# (one per symbol-session) and is regenerated by one scan; the trades CSV is
# re-selected from it for free with --reuse-candidates.
results/backtest_candidates.parquet
results/backtest_t1_trades_top*.csv
